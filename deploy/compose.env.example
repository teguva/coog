# Copy to compose.env (gitignored) next to docker-compose.yml:
#   cp compose.env.example compose.env
#   docker compose --env-file compose.env up -d
#
# CoduOS / CasaOS / ZimaOS:
#   library  /DATA/Media/{Movies,Series,Maize}
#   app data /DATA/AppData/coog
#
# Use absolute host paths. Relative paths like ./library are created inside
# the app folder (/DATA/AppData/coog), not on the media disk.

COOG_VERSION=0.1.20
COOG_PORT=8090
TZ=Europe/Tallinn

COOG_LIBRARY_PATH=/DATA/Media
COOG_DATA_PATH=/DATA/AppData/coog

# Shared bearer token for /api/* (leave empty only on a trusted lab host).
# Paste the same value in the TV app Settings and the admin sidebar.
COOG_AUTH_TOKEN=change-me

COOG_TMDB_API_KEY=
REALDEBRID_API_TOKEN=
OPENSUBTITLES_API_KEY=

# Interactive (Maize toys). Image includes intiface-engine; leave true on CoduOS.
# Host Bluetooth + D-Bus socket must be available to the api container.
COOG_INTIFACE_ENABLED=true
