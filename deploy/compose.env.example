# Copy to compose.env (gitignored) next to docker-compose.yml:
#   cp compose.env.example compose.env
#   docker compose --env-file compose.env up -d
#
# Image tag from GitHub Container Registry (omit to use :latest).
COOG_VERSION=0.1.17

# Host port published as http://<lan-ip>:8090
COOG_PORT=8090

# Host library root. Bind-mounted at /library in both containers.
# Layout: Movies/, Series/, optional Maize/
COOG_LIBRARY_PATH=/home/REPLACE/Videos

# Shared bearer token for /api/* (leave empty only on a trusted lab host).
# Paste the same value in the TV app Settings and the admin sidebar.
COOG_AUTH_TOKEN=change-me

# Optional. TMDB overlay after IMDB/Cinemeta.
COOG_TMDB_API_KEY=

# Optional. Real-Debrid token for catalog streams / debrid jobs.
REALDEBRID_API_TOKEN=

# Optional. OpenSubtitles key for sidecar subs.
OPENSUBTITLES_API_KEY=
