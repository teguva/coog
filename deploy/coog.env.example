# systemd native install: copy to /etc/coog/coog.env or ~/.config/coog/coog.env
# Docker Compose: use compose.env.example instead (deploy/compose.env.example).
COOG_LISTEN=:8090
COOG_LIBRARY_PATH=/home/REPLACE/Videos
COOG_DATA_PATH=/home/REPLACE/.local/share/coog
COOG_FFMPEG=ffmpeg
COOG_FFPROBE=ffprobe
